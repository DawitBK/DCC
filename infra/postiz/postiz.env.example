# Variable NAMES used by Postiz's upstream docker-compose (read 2026-11-10). Verify against the pinned tag
# in VERSION before use. Values below are placeholders: real values live outside Git.

MAIN_URL=https://postiz.internal.example
FRONTEND_URL=https://postiz.internal.example
NEXT_PUBLIC_BACKEND_URL=https://postiz.internal.example/api
BACKEND_INTERNAL_URL=http://localhost:3000

# Generate a long random value on the server; never reuse across environments.
JWT_SECRET=replace-with-a-long-random-value

DATABASE_URL=postgresql://postiz-user:replace-with-password@postiz-postgres:5432/postiz-db-local
REDIS_URL=redis://postiz-redis:6379
TEMPORAL_ADDRESS=temporal:7233

# Only engine administrators get accounts; users never do.
DISABLE_REGISTRATION=true
IS_GENERAL=true

STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# Social network developer apps (one pair per network, from each network's developer portal):
# X_API_KEY= X_API_SECRET=
# LINKEDIN_CLIENT_ID= LINKEDIN_CLIENT_SECRET=
# FACEBOOK_APP_ID= FACEBOOK_APP_SECRET=
# YOUTUBE_CLIENT_ID= YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_ID= TIKTOK_CLIENT_SECRET=
