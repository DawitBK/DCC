# DCC development environment. Copy to .env (git-ignored) and adjust. NEVER commit .env.
# Every value below is a DEVELOPMENT placeholder. Production values live on the server (infra/deployment/).
# All names start with DCC_/OIDC_/POSTIZ_ on purpose: a stray machine-wide DATABASE_URL on a
# developer PC must never be picked up by accident.

NODE_ENV=development
LOG_LEVEL=info

# --- Ports (registered in the platform port registry: DCC = 7716 API, 7717 web; mirror 9716/9717) ---
# Windows PCs can reserve ranges that include these (EACCES on listen). If so, pick free ports and
# change the four places that mention them: docs/devops/WINDOWS-PORTS.md
DCC_API_PORT=7716
DCC_WEB_PORT=7717
DCC_WEB_ORIGIN=http://localhost:7717
# Browser -> web proxy -> API: one proxy hop in development.
DCC_TRUST_PROXY_HOPS=1

# --- Database (PostgreSQL 16+; `npm run infra:up` starts one on 127.0.0.1:5436) ---
DCC_DB_PORT=5436
DCC_DB_NAME=dcc_dev
DCC_TEST_DB_NAME=dcc_test
# Superuser: used ONLY by `npm run db:bootstrap` to create the two roles and the databases.
DCC_PG_ADMIN_PASSWORD=dev-only-change-me-admin
DCC_ADMIN_DATABASE_URL=postgres://postgres:dev-only-change-me-admin@127.0.0.1:5436/postgres
# dcc_owner owns the schema and runs migrations. The running API never uses it.
DCC_OWNER_PASSWORD=dev-only-change-me-owner
DCC_MIGRATE_DATABASE_URL=postgres://dcc_owner:dev-only-change-me-owner@127.0.0.1:5436/dcc_dev
# dcc_app is what the API connects as: no superuser, no BYPASSRLS, cannot create or drop anything.
DCC_APP_PASSWORD=dev-only-change-me-app
DCC_DATABASE_URL=postgres://dcc_app:dev-only-change-me-app@127.0.0.1:5436/dcc_dev
DCC_DB_POOL_MAX=10

# --- Existing Kerchanshe SSO / IdP (OIDC authorization code + PKCE) ---
# Issuer is the browser-facing address (dev SSO frontend). Register the client first:
# docs/identity-and-sso/DEV-CLIENT-REGISTRATION.md
OIDC_ISSUER=http://localhost:7301
# Server-to-server address of the IdP backend when it differs from the issuer (dev SSO backend):
OIDC_INTERNAL_URL=http://localhost:7300
OIDC_CLIENT_ID=dcc
OIDC_CLIENT_SECRET=dev-only-change-me-dcc-client-secret
OIDC_REDIRECT_URI=http://localhost:7717/api/auth/callback
OIDC_POST_LOGOUT_URI=http://localhost:7717/
OIDC_SCOPES=openid profile email app_roles
OIDC_APP_ROLES_CLAIM=https://idp.kerchanshe.com/app_roles
OIDC_GROUP_ADMIN_ROLE=dcc-group-admin
DCC_DEFAULT_GROUP_SLUG=kerchanshe
# DEVELOPMENT ONLY: comma-separated emails treated as group admins at login (refused in production).
DCC_DEV_BOOTSTRAP_ADMIN_EMAILS=

# --- Sessions ---
# Require a second factor (amr=mfa from the SSO). Unset = on in production, off in development.
# Cannot be "false" in production. The SSO also enforces it via its mfa.requiredApps setting.
DCC_REQUIRE_MFA=
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30

# --- Secrets / encryption (development provider only; refused in production) ---
SECRETS_PROVIDER=local-dev
# DEVELOPMENT ONLY and shared on purpose so a fresh clone runs with no edits (the value spells "dcc-dev-only-key-not-a-secret").
# It protects nothing real: the dev provider is refused in production. Never use it anywhere real.
DCC_LOCAL_ENCRYPTION_KEY=ZGNjLWRldi1vbmx5LWtleS1ub3QtYS1zZWNyZXQhISE=

# --- Operational engine (Postiz). 'fake' needs nothing. See docs/engine/POSTIZ-INTEGRATION.md ---
ENGINE_PROVIDER=fake
POSTIZ_BASE_URL=
POSTIZ_API_KEY=

# --- Observability ---
# Unset = /api/metrics is off. Set a long random value to enable it (Prometheus sends it as a bearer token).
METRICS_TOKEN=
DCC_ENABLE_API_DOCS=

# --- Web app (portal/frontend) ---
# Where the Next.js server reaches the API (server-side only).
DCC_API_INTERNAL_URL=http://127.0.0.1:7716
