# Settings read by compose.postiz.yml (see CUSTOMIZATIONS.md). Copy to postiz.env; real values never go in Git.

MAIN_URL=https://postiz.internal.example
FRONTEND_URL=https://postiz.internal.example
NEXT_PUBLIC_BACKEND_URL=https://postiz.internal.example/api

# Generate a long random value on the server; never reuse across environments.
JWT_SECRET=replace-with-a-long-random-value

POSTIZ_DB_PASSWORD=replace-with-a-long-random-value
TEMPORAL_DB_PASSWORD=replace-with-a-long-random-value
# Port on this host (loopback only).
POSTIZ_PORT=4007
# Only on a developer computer without HTTPS:
# NOT_SECURED=true

# Only engine administrators get accounts; users never do.
DISABLE_REGISTRATION=true


# Social network developer apps (one pair per network, from each network's developer portal):
# X_API_KEY= X_API_SECRET=
# LINKEDIN_CLIENT_ID= LINKEDIN_CLIENT_SECRET=
# FACEBOOK_APP_ID= FACEBOOK_APP_SECRET=
# YOUTUBE_CLIENT_ID= YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_ID= TIKTOK_CLIENT_SECRET=
