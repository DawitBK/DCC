{
  "name": "@dcc/backend",
  "version": "0.1.0",
  "private": true,
  "description": "DCC governance API (NestJS modular monolith). Platform code in src/platform is Dawit's; business modules in src/modules are Hirko's.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/platform/database/migrate-cli.ts",
    "db:seed": "tsx src/platform/database/seed.ts",
    "dev:session": "tsx src/platform/database/dev-session.ts"
  },
  "dependencies": {
    "@dcc/contracts": "0.1.0",
    "@dcc/engine-client": "0.1.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "kysely": "^0.29.8",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
