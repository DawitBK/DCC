{
  "name": "@dcc/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "DCC web application (Next.js). Owner: Rahel. This is a scaffold: layout, design tokens, sign-in and a session check. The product UI is built on top of it.",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:mirror": "node ../../scripts/run-with-env.mjs .env.mirror node ../../node_modules/next/dist/bin/next build",
    "start:mirror": "node ../../scripts/run-with-env.mjs .env.mirror node scripts/run-next.mjs start"
  },
  "dependencies": {
    "@dcc/contracts": "0.1.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3"
  }
}
